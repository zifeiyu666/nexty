{
  "manifest_version": 3,
  "name": "SendTheSong – AI Song Gifts",
  "description": "Save a meaningful memory and continue creating a personalized song with SendTheSong.",
  "version": "0.1.0",
  "action": {
    "default_title": "SendTheSong",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://sendthesong.io/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sendthesong-extension@sendthesong.io",
      "strict_min_version": "121.0"
    }
  }
}
